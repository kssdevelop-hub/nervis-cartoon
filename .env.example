# Runway API Configuration
# Скопируйте этот файл в .env и добавьте ваш реальный API ключ

RUNWAY_API_KEY=your_runway_api_key_here
GENERATION_MODEL=gen3
GENERATION_RESOLUTION=1920x1080
GENERATION_DURATION=10
GENERATION_FPS=24

# Где получить API ключ:
# https://dev.runway.com/organization/[your-org-id]/api-keys
